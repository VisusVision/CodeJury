# Database (matches docker-compose.yml: semas / agent_db)
DATABASE_URL=postgresql+asyncpg://semas:12345@localhost:5432/agent_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Sandbox settings
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPU_SECONDS=10
SANDBOX_MAX_PIDS=64

# Sandbox Pool
SANDBOX_IMAGE=agentgrade-sandbox
SANDBOX_POOL_SIZE=10
SANDBOX_POOL_BASE_PORT=8181
SANDBOX_POOL_TIMEOUT=30.0

# Worker sandbox readiness / heartbeat (owned by the analysis worker process only — API never starts a pool)
SANDBOX_READY_TIMEOUT_SECONDS=15
SANDBOX_POOL_OWNER=analysis-worker-1
ANALYSIS_WORKER_ID=analysis-worker-1
ANALYSIS_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
ANALYSIS_WORKER_HEARTBEAT_TTL_SECONDS=15
ANALYSIS_WORKER_SANDBOX_RETRY_SECONDS=5

# Demo Mode (1 = in-memory store, no PostgreSQL)
DEMO_MODE=0

# API
API_SECRET_KEY=change-this-to-a-random-secret
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# LLM provider: ollama or nvidia_nim
LLM_PROVIDER=ollama
# Optional per-role overrides. Empty values follow LLM_PROVIDER.
LLM_GENERAL_PROVIDER=
LLM_CODER_PROVIDER=

# Ollama (local LLM — one coder model is enough; general can match coder)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERAL_MODEL=qwen2.5-coder:14b-instruct-q6_K
OLLAMA_CODER_MODEL=qwen2.5-coder:14b-instruct-q6_K
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT=300.0
OLLAMA_MAX_CONCURRENT=2
OLLAMA_NUM_PREDICT=3072
# Coder agent inference (qwen2.5-coder:14b-instruct-q6_K, 5070 Ti 16GB)
OLLAMA_CODER_NUM_CTX=16384
OLLAMA_CODER_NUM_GPU=-1
OLLAMA_CODER_TEMPERATURE=0.0
OLLAMA_CODER_TOP_P=0.9
OLLAMA_CODER_REPEAT_PENALTY=1.15
# Optional for gpt-oss models only:
# OLLAMA_GPT_OSS_NUM_PREDICT=4096
# OLLAMA_GPT_OSS_THINK=low

# NVIDIA NIM (used when LLM_PROVIDER=nvidia_nim)
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_GENERAL_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_NIM_CODER_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_NIM_MAX_CONCURRENT=2
NVIDIA_NIM_RPM_LIMIT=40
NVIDIA_NIM_TIMEOUT=180.0
NVIDIA_NIM_NUM_PREDICT=8192

# Recommended hybrid (chatbot/rubrik on NIM, code agents on Ollama 14B):
# LLM_PROVIDER=nvidia_nim
# LLM_GENERAL_PROVIDER=nvidia_nim
# LLM_CODER_PROVIDER=ollama

# --- Lite profile (8 GB RAM / weak GPU / first-time local user) ---
# Copy these over the defaults above if full setup is too slow or OOM:
# SANDBOX_POOL_SIZE=3
# OLLAMA_GENERAL_MODEL=qwen2.5-coder:7b
# OLLAMA_CODER_MODEL=qwen2.5-coder:7b
# OLLAMA_MAX_CONCURRENT=1
# OLLAMA_CODER_NUM_CTX=8192
