# Database (matches docker-compose.yml: semas / agent_db)
DATABASE_URL=postgresql+asyncpg://semas:12345@localhost:5432/agent_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Sandbox settings
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPU_SECONDS=10
SANDBOX_MAX_PIDS=64

# Sandbox Pool
SANDBOX_IMAGE=agentgrade-sandbox
SANDBOX_POOL_SIZE=10
SANDBOX_POOL_BASE_PORT=8181
SANDBOX_POOL_TIMEOUT=30.0

# Demo Mode (1 = in-memory store, no PostgreSQL)
DEMO_MODE=0

# API
API_SECRET_KEY=change-this-to-a-random-secret

# LLM provider: ollama or nvidia_nim
LLM_PROVIDER=ollama
# Optional per-role overrides. Empty values follow LLM_PROVIDER.
LLM_GENERAL_PROVIDER=
LLM_CODER_PROVIDER=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERAL_MODEL=qwen2.5:7b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT=900.0

# NVIDIA NIM (used when LLM_PROVIDER=nvidia_nim)
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_GENERAL_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_NIM_CODER_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_NIM_MAX_CONCURRENT=2
NVIDIA_NIM_RPM_LIMIT=40
NVIDIA_NIM_TIMEOUT=180.0
NVIDIA_NIM_NUM_PREDICT=8192

# Recommended hybrid for production/demo (chatbot/rubric on NIM, code agents on Ollama):
# LLM_PROVIDER=nvidia_nim
# LLM_GENERAL_PROVIDER=nvidia_nim
# LLM_CODER_PROVIDER=ollama
