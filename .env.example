# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/code_review

# Redis
REDIS_URL=redis://localhost:6379/0

# Sandbox settings
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPU_SECONDS=10
SANDBOX_MAX_PIDS=64

# API
API_SECRET_KEY=change-this-to-a-random-secret

# LLM provider: ollama or nvidia_nim
LLM_PROVIDER=ollama
# Optional per-role overrides. Empty values follow LLM_PROVIDER.
LLM_GENERAL_PROVIDER=
LLM_CODER_PROVIDER=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERAL_MODEL=qwen2.5:7b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_ENABLED=true

# NVIDIA NIM (used when LLM_PROVIDER=nvidia_nim)
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_GENERAL_MODEL=qwen/qwen2.5-coder-32b-instruct
NVIDIA_NIM_CODER_MODEL=qwen/qwen2.5-coder-32b-instruct
NVIDIA_NIM_MAX_CONCURRENT=2
NVIDIA_NIM_RPM_LIMIT=35
NVIDIA_NIM_NUM_PREDICT=3072
